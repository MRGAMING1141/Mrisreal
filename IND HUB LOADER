Instance.new("UICorner", Main).CornerRadius = UDim.new(0, 14)

local Glow = Instance.new("UIStroke", Main)
Glow.Thickness = 2

local hue = 0
RunService.RenderStepped:Connect(function()
    hue = (hue + 0.002) % 1
    Glow.Color = Color3.fromHSV(hue, 1, 1)
end)

